<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="casa_de_lo.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="1"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2123"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="clientes" custom_title="0" dock_id="3" table="4,8:mainclientes"/><dock_state state=""/><default_encoding codec=""/><browse_table_settings><table schema="main" name="clientes" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="63"/><column index="2" value="175"/><column index="3" value="135"/><column index="4" value="79"/><column index="5" value="247"/><column index="6" value="127"/><column index="7" value="151"/><column index="8" value="71"/><column index="9" value="103"/><column index="10" value="300"/><column index="11" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">DROP TRIGGER IF EXISTS atualizar_cliente_apos_insercao;
DROP TRIGGER IF EXISTS atualizar_cliente_apos_atualizacao;

-- Triggers com o prefixo 'ENC-' corrigido
CREATE TRIGGER atualizar_cliente_apos_insercao
AFTER INSERT ON encomendas
BEGIN
    UPDATE clientes
    SET 
        id_encomenda_ativa = 'ENC-' || NEW.id_encomenda,
        status_encomenda = NEW.status,
        valor_total = NEW.valor_total,
        valor_em_divida = NEW.valor_total
    WHERE id_cliente = NEW.id_cliente;
END;

CREATE TRIGGER atualizar_cliente_apos_atualizacao
AFTER UPDATE ON encomendas
BEGIN
    UPDATE clientes
    SET 
        id_encomenda_ativa = 'ENC-' || NEW.id_encomenda,
        status_encomenda = NEW.status,
        valor_total = NEW.valor_total,
        valor_em_divida = CASE WHEN NEW.status = 'Concluída' THEN 0.0 ELSE NEW.valor_total END
    WHERE id_cliente = NEW.id_cliente;
END;

-- Corrige também a linha do CLI015 que tinha ficado sem o prefixo
UPDATE clientes SET id_encomenda_ativa = 'ENC-21' WHERE id_cliente = 'CLI015';

</sql><current_tab id="0"/></tab_sql></sqlb_project>
